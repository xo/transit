          "content": {
            "type": "IMMEDIATE_TOKEN",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "d"
                },
                {
                  "type": "STRING",
                  "value": "e"
                }
              ]
            }
          },
          "named": true,
          "value": "Y"
        }
      ]
    }
  },
