      "members": [
        {
          "type": "STRING",
          "value": "a"
        },
        {
          "type": "BLANK"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
