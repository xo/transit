{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "last_child_anchor_past_hidden_repeat",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "trailing_sep"
          },
          {
            "type": "SYMBOL",
            "name": "leading_sep"
          },
          {
            "type": "SYMBOL",
            "name": "trailing_named"
          }
        ]
      }
    },
    "trailing_sep": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "T"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "name"
              },
              {
                "type": "STRING",
                "value": "."
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "name"
        }
      ]
    },
    "leading_sep": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "L"
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "."
              },
              {
                "type": "SYMBOL",
                "name": "name"
              }
            ]
          }
        }
      ]
    },
    "trailing_named": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "N"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "name"
              },
              {
                "type": "SYMBOL",
                "name": "tag"
              },
              {
                "type": "STRING",
                "value": "."
              }
            ]
          }
        },
        {
          "type": "SYMBOL",
          "name": "name"
        }
      ]
    },
    "tag": {
      "type": "STRING",
      "value": "!"
    },
    "name": {
      "type": "PATTERN",
      "value": "[a-z]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}