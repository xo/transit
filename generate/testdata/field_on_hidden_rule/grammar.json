{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "field_on_hidden_rule",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "binding"
          },
          {
            "type": "SYMBOL",
            "name": "sum"
          },
          {
            "type": "SYMBOL",
            "name": "call"
          }
        ]
      }
    },
    "binding": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "let"
        },
        {
          "type": "FIELD",
          "name": "outer",
          "content": {
            "type": "SYMBOL",
            "name": "_binding"
          }
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_binding": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "inner",
          "content": {
            "type": "SYMBOL",
            "name": "name"
          }
        },
        {
          "type": "STRING",
          "value": "="
        },
        {
          "type": "SYMBOL",
          "name": "name"
        }
      ]
    },
    "sum": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "sum"
        },
        {
          "type": "SYMBOL",
          "name": "_sum"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_sum": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "FIELD",
              "name": "left",
              "content": {
                "type": "SYMBOL",
                "name": "_sum"
              }
            },
            {
              "type": "STRING",
              "value": "+"
            },
            {
              "type": "SYMBOL",
              "name": "name"
            }
          ]
        }
      ]
    },
    "call": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "call"
        },
        {
          "type": "FIELD",
          "name": "arg",
          "content": {
            "type": "SYMBOL",
            "name": "_call"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        },
        {
          "type": "STRING",
          "value": ";"
        }
      ]
    },
    "_call": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "FIELD",
          "name": "arg",
          "content": {
            "type": "SYMBOL",
            "name": "name"
          }
        }
      ]
    },
    "name": {
      "type": "PATTERN",
      "value": "[a-z]+"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
