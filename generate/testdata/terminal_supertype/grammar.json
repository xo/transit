{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "terminal_supertype",
  "rules": {
    "source_file": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "B"
        },
        {
          "type": "SYMBOL",
          "name": "A"
        }
      ]
    },
    "lineComment": {
      "type": "PATTERN",
      "value": ";;.*"
    },
    "lineComment2": {
      "type": "PATTERN",
      "value": "##.*"
    },
    "A": {
      "type": "PATTERN",
      "value": "xyz"
    },
    "C": {
      "type": "STRING",
      "value": "xyz"
    },
    "B": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "abc"
        },
        {
          "type": "SYMBOL",
          "name": "C"
        }
      ]
    }
  },
  "extras": [
    {
      "type": "SYMBOL",
      "name": "lineComment"
    },
    {
      "type": "SYMBOL",
      "name": "lineComment2"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [
    "A"
  ],
  "reserved": {}
}