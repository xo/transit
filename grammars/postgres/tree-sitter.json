{
  "grammars": [
    {
      "name": "postgres",
      "camelcase": "Postgres",
      "scope": "source.postgres",
      "path": "postgres",
      "file-types": [
        "pgsql"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^(postgres|postgresql)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A grammar of the SQL of PostgreSQL 19",
    "links": {
      "repository": "https://github.com/xo/transit"
    }
  }
}
